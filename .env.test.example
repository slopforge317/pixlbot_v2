# Copy to .env.test on the server. Never commit the real file.

# Public endpoint
APP_DOMAIN=tma.pixlbot.ru

# PostgreSQL
POSTGRES_USER=pixlbot
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=pixlbot
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=pixlbot_v2_postgres_data

# Telegram BotFather bot (regular production Telegram API)
BOT_TOKEN=replace-with-the-test-bot-token
TELEGRAM_BOT_ENABLED=true
TELEGRAM_TEST_MODE=false
TMA_URL=https://tma.pixlbot.ru
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Telegram Mini App auth
INIT_DATA_EXPIRE_SECONDS=3600
WELCOME_BONUS_CREDITS=5

# Disable legacy side effects during the first test deployment
FUNNEL_ENABLED=false
PAYMENT_CLEANUP_ENABLED=false

# KIE API (disabled until the generation stage)
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_POLL_INTERVAL=3.0
KIE_POLL_TIMEOUT=300.0
KIE_CALLBACK_ENABLED=false
KIE_CALLBACK_SECRET=replace-with-a-long-random-secret

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_JSON=true

# S3-compatible storage (disabled until the uploads stage)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_UPLOAD_MAX_SIZE_BYTES=10485760
S3_PRESIGN_UPLOAD_EXPIRES=600
S3_PRESIGN_DOWNLOAD_EXPIRES=3600

# YooKassa (disabled until the payments stage)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://tma.pixlbot.ru/packages?payment=success

# Monitoring (not started during the first deployment stage)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
