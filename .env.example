# Local project settings. Copy this file to .env and replace placeholders.

# PostgreSQL
POSTGRES_USER=pixlbot
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=pixlbot
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433

# Published application ports
BACKEND_PORT=8000
TMA_PORT=8080
TMA_DEV_PORT=5173
NGROK_WEB_PORT=4040

# Telegram
BOT_TOKEN=replace-with-a-telegram-bot-token
TELEGRAM_TEST_MODE=false
TMA_URL=http://localhost:5173
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=replace-with-a-random-secret

# Telegram Mini App development
VITE_API_URL=/api
VITE_DEV_API_PROXY_TARGET=http://backend:8000
VITE_MOCK_INIT_DATA=
NGROK_AUTHTOKEN=

# KIE API
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_POLL_INTERVAL=3.0
KIE_POLL_TIMEOUT=300.0
KIE_CALLBACK_ENABLED=false
KIE_CALLBACK_SECRET=replace-with-a-random-secret

# Authentication and bonuses
INIT_DATA_EXPIRE_SECONDS=3600
WELCOME_BONUS_CREDITS=5

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_JSON=false

# S3-compatible storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_UPLOAD_MAX_SIZE_BYTES=10485760
S3_PRESIGN_UPLOAD_EXPIRES=600
S3_PRESIGN_DOWNLOAD_EXPIRES=3600

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/packages?payment=success

# Monitoring (used by compose.monitoring.yaml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-for-local-development
