            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "done": { "color": "green", "index": 0, "text": "done" },
                      "error": { "color": "red", "index": 1, "text": "error" },
                      "queue": { "color": "orange", "index": 2, "text": "queue" },
                      "processing": { "color": "blue", "index": 3, "text": "processing" }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
