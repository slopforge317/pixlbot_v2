      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 6 },
      "id": 1,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          { "displayName": "created_at", "desc": true }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  g.job_id,\n  g.user_id,\n  u.telegram_user_id,\n  u.username,\n  m.api_model_id,\n  g.status::text AS status,\n  g.prompt,\n  g.success_url_asset,\n  g.created_at,\n  g.error\nFROM generations_job g\nLEFT JOIN users u ON g.user_id = u.user_id\nLEFT JOIN pricing_variants pv ON g.pricing_variant_id = pv.id\nLEFT JOIN ai_models m ON pv.model_id = m.id\nWHERE\n  g.created_at >= $__timeFrom()\n  AND g.created_at <= $__timeTo()\n  AND ('$status' = 'All' OR g.status::text = '$status')\nORDER BY g.created_at DESC\nLIMIT 500",
          "refId": "A"
        }
      ],
      "title": "Generation Jobs",
      "type": "table"
    }
  ],
