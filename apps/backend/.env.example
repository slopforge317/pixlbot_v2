# Telegram Bot
BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_ENABLED=true
TELEGRAM_TEST_MODE=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://pixlbot:pixlbot_secret@localhost:5432/pixlbot
POSTGRES_PASSWORD=pixlbot_secret

# Test database (for pytest)
TEST_DATABASE_URL=postgresql+asyncpg://pixlbot:pixlbot_test@localhost:5432/pixlbot_pytest

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# KIE API (kie.ai)
KIE_API_KEY=your_api_key_here
KIE_API_BASE_URL=https://api.kie.ai
KIE_POLL_INTERVAL=3.0
KIE_POLL_TIMEOUT=300.0

# Auth
INIT_DATA_EXPIRE_SECONDS=3600

# Webhook (production)
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=your_random_secret_here

# KIE Callback (webhook)
KIE_CALLBACK_ENABLED=false
KIE_CALLBACK_SECRET=your_random_secret_here
KIE_WEBHOOK_HMAC_KEY=your_kie_webhook_hmac_key_here
KIE_WEBHOOK_MAX_AGE_SECONDS=300
KIE_RECONCILIATION_INTERVAL_SECONDS=60
KIE_RECONCILIATION_STALE_SECONDS=60
KIE_RECONCILIATION_BATCH_SIZE=100

# TMA (Telegram Mini App)
TMA_URL=https://pixlbot.ru

# Bonuses
WELCOME_BONUS_CREDITS=5

# Background workers
FUNNEL_ENABLED=true
PAYMENT_CLEANUP_ENABLED=true

# Cloudflare R2 (S3-compatible API)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_UPLOAD_MAX_SIZE_BYTES=31457280
R2_PRESIGN_UPLOAD_EXPIRES=600
R2_PRESIGN_DOWNLOAD_EXPIRES=3600

# YooKassa Payments
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here
YOOKASSA_RETURN_URL=https://pixlbot.ru/packages?payment=success
