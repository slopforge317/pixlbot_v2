# Telegram Bot
BOT_TOKEN=your_bot_token_here
TELEGRAM_TEST_MODE=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://pixlbot:pixlbot_secret@localhost:5432/pixlbot
POSTGRES_PASSWORD=pixlbot_secret

# Test database (for pytest)
TEST_DATABASE_URL=postgresql+asyncpg://pixlbot:pixlbot_test@localhost:5432/pixlbot_pytest

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# KIE API (kie.ai)
KIE_API_KEY=your_api_key_here
KIE_API_BASE_URL=https://api.kie.ai
KIE_POLL_INTERVAL=3.0
KIE_POLL_TIMEOUT=300.0

# Auth
INIT_DATA_EXPIRE_SECONDS=3600

# Webhook (production)
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=your_random_secret_here

# KIE Callback (webhook)
KIE_CALLBACK_ENABLED=false
KIE_CALLBACK_SECRET=your_random_secret_here

# TMA (Telegram Mini App)
TMA_URL=https://pixlbot.ru

# Bonuses
WELCOME_BONUS_CREDITS=5

# Yandex Cloud Storage (S3-compatible)
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_BUCKET_NAME=your_bucket_name_here
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_UPLOAD_MAX_SIZE_BYTES=10485760
S3_PRESIGN_UPLOAD_EXPIRES=600
S3_PRESIGN_DOWNLOAD_EXPIRES=3600

# YooKassa Payments
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here
YOOKASSA_RETURN_URL=https://pixlbot.ru/packages?payment=success
