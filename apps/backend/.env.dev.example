# Copy to .env.dev and fill BOT_TOKEN before running docker-compose.dev.yml.
# This file is for a real Telegram bot in polling mode, not Telegram test mode.

# Telegram Bot
BOT_TOKEN=
TELEGRAM_TEST_MODE=false

# Backend HTTP port on the host
BACKEND_PORT=8000

# Database
POSTGRES_PASSWORD=pixlbot_secret
POSTGRES_PORT=5432

# Telegram webhook is disabled in local dev; updates are received via polling.
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=dev-webhook-secret

# TMA URL is used for bot WebApp buttons.
# For ngrok with a random URL, copy the generated https URL here and restart backend.
# For ngrok with a reserved static domain, set that stable https URL here.
TMA_URL=http://localhost:8080

# Telegram Mini App frontend / ngrok tunnel. Required only for:
# docker compose --env-file tma-backend/.env.dev -f docker-compose.dev.yml --profile tma up -d
TMA_FRONTEND_PORT=5173
NGROK_WEB_PORT=4040
NGROK_AUTHTOKEN=

# KIE API. Leave empty while testing only /start, menus, DB, and bot connectivity.
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_POLL_INTERVAL=3.0
KIE_POLL_TIMEOUT=300.0
KIE_CALLBACK_ENABLED=false
KIE_CALLBACK_SECRET=dev-kie-secret

# Auth
INIT_DATA_EXPIRE_SECONDS=3600

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_JSON=false

# Credits granted to a new Telegram user on /start.
WELCOME_BONUS_CREDITS=5

# S3-compatible storage. Required only for reference uploads.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_UPLOAD_MAX_SIZE_BYTES=10485760
S3_PRESIGN_UPLOAD_EXPIRES=600
S3_PRESIGN_DOWNLOAD_EXPIRES=3600

# YooKassa. Not needed for basic bot/backend dev startup.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080/packages?payment=success
