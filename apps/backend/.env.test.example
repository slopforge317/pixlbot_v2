# Copy this file to .env.test and fill BOT_TOKEN before running docker-compose.test.yml.
# Use a bot token created in Telegram test environment, not a production bot token.

# Telegram test bot
BOT_TOKEN=your_test_bot_token_here
TELEGRAM_TEST_MODE=true

# Test Mini App URL.
# Telegram Desktop on this Windows machine: http://localhost:8080
# Mobile on the same Wi-Fi: use your Windows LAN IP, for example http://192.168.1.10:8080
# Mobile outside LAN: use an HTTPS tunnel URL from ngrok/cloudflared.
TMA_URL=http://localhost:8080
TMA_PORT=8080

# Backend debug port on host
BACKEND_PORT=8000

# Optional: signed Telegram initData for opening TMA outside Telegram.
# Generate it with: docker compose --env-file tma-backend/.env.test -f docker-compose.test.yml exec -T backend python scripts/generate_init_data.py
VITE_API_URL=/api
VITE_MOCK_INIT_DATA=

# Database
POSTGRES_PASSWORD=pixlbot_secret
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://pixlbot:pixlbot_secret@postgres:5432/pixlbot

# Telegram webhook is disabled in test mode; bot receives updates via polling.
WEBHOOK_ENABLED=false
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=test-webhook-secret

# KIE API. Leave empty if you only test UI/auth/navigation without real generation.
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_POLL_INTERVAL=3.0
KIE_POLL_TIMEOUT=300.0
KIE_CALLBACK_ENABLED=false
KIE_CALLBACK_SECRET=test-kie-secret

# Auth
INIT_DATA_EXPIRE_SECONDS=3600

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_JSON=false

# Test credits for new users
WELCOME_BONUS_CREDITS=100

# S3-compatible storage. Required only for reference uploads.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_UPLOAD_MAX_SIZE_BYTES=10485760
S3_PRESIGN_UPLOAD_EXPIRES=600
S3_PRESIGN_DOWNLOAD_EXPIRES=3600

# YooKassa. Not needed for basic test-mode TMA launch.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080/packages?payment=success
